rules_version = '2';
// Security rules for "דירות של קדושה".
// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function prof() { return get(profPath()).data; }
    function active() { return signedIn() && exists(profPath()) && prof().get('disabled', false) != true
      && prof().role in ['manager', 'cleaning', 'maintenance']; }
    function hasRole(r) { return active() && prof().role == r; }
    function isMgr() { return hasRole('manager'); }
    function isCleaner() { return hasRole('cleaning'); }
    function isMaint() { return hasRole('maintenance'); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function setupPath() { return /databases/$(database)/documents/meta/setup; }

    // Marks that the first manager exists. Readable by anyone so the sign-in
    // screen knows whether to offer first-time setup.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !exists(setupPath()) && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // People and their roles.
    match /users/{uid} {
      allow read: if active() || (signedIn() && request.auth.uid == uid);
      // The very first manager, written in the same batch as meta/setup.
      allow create: if isMgr()
        || (signedIn() && uid == request.auth.uid
            && !exists(setupPath()) && existsAfter(setupPath())
            && request.resource.data.role == 'manager')
        // Self-registration: anyone signed in may ask to join. A manager approves and sets the role.
        || (signedIn() && uid == request.auth.uid && exists(setupPath())
            && request.resource.data.role == 'pending'
            && request.resource.data.keys().hasOnly(['name', 'username', 'role', 'at', 'note'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 60
            && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300);
      allow update: if isMgr();
      allow delete: if false;
    }

    match /units/{unit} {
      allow read: if active();
      allow create, delete: if isMgr();
      allow update: if isMgr() || (isCleaner() && onlyChanged(['clean', 'cleanAt', 'cleanBy']));
    }

    match /issues/{id} {
      allow read: if active();
      allow create: if isMgr() || (active() && request.resource.data.by == request.auth.uid);
      allow update: if isMgr() || (isMaint() && onlyChanged(['status', 'doneAt', 'doneBy']));
      allow delete: if isMgr();
    }

    // Activity log: everyone writes their own entries, only managers read it.
    match /log/{id} {
      allow read: if isMgr();
      allow create: if active() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    match /settings/{id} {
      allow read: if active();
      allow write: if isMgr();
    }

    // Push notification tokens: each device registers itself for the signed-in user.
    // Nobody reads them from the site; the notification script reads them with the owner's access.
    match /pushTokens/{token} {
      allow create, update: if active() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'lang', 'at', 'ua']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }

    // Bookings, payments, income and expenses: managers only.
    match /fin/{rest=**} {
      allow read, write: if isMgr();
    }
  }
}
